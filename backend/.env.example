# FitBuddy Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ─── Required ────────────────────────────────────────────────────────────────

# Your Groq API key. Obtain one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_real_key_here

# ─── Optional ────────────────────────────────────────────────────────────────

# Groq model to use for LLM inference.
# Default: llama-3.1-8b-instant  (fast, high quality, active production model)
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# Upstream request timeout in seconds (default: 30.0)
GROQ_TIMEOUT_SECONDS=30.0

# Port to bind the server on. Default: 8000
PORT=8000

# Comma-separated CORS allowed origins (for browser-based testing / admin UI).
# Leave empty to disable CORS header injection.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
